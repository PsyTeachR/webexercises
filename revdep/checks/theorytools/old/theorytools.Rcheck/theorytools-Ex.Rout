> 
> ### Name: derive_formula
> ### Title: Derive Formulae From Augmented DAG
> ### Aliases: derive_formula
> 
> ### ** Examples
> 
> x <- dagitty::dagitty('dag {
+ C
+ O
+ X
+ Y
+ O <- X [form="I(X^2)"]
+ C -> X
+ Y -> O [form="Y*X"]
+ }')
> f1 <- derive_formula(x, outcome = "O", exposure = "X")
> f2 <- derive_formula(x, outcome = "O", exposure = "Y")
> 
